@page "/forgot-password"

@using Blazilla
@using Whispr.Presentation.Web.Components.Features.CardContainer
@using Whispr.Presentation.Web.Components.Features.ProblemAlerts
@using Whispr.Presentation.Web.Components.Ui.Buttons
@using Whispr.Presentation.Web.Components.Ui.Inputs
@using Whispr.Presentation.Web.Core.Enums

<PageTitle>Whispr :: Esqueci Minha Senha</PageTitle>

<CardContainer Title="Esqueci Minha Senha">
    @if (!_hasRecoveryCode)
    {
        <EditForm Model="@_passwordRecoveryCodeModel" OnValidSubmit="HandleSubmitCreatePasswordRecoveryCode">
            <FluentValidator />

            <EmailInput @bind-Value="_passwordRecoveryCodeModel.Email" Label="Email" IsRequired="true" WrapperCssClass="mb-3" />

            <Button Type="ButtonType.Submit" Color="ButtonColors.Primary" CssClass="w-100" IsLoading="_isLoadingPasswordRecoveryCode">Enviar</Button>

        </EditForm>
    }

    @if (_hasRecoveryCode)
    {
        <EditForm Model="@_passwordResetModel" OnSubmit="HandleSubmitChangePassword">
            <FluentValidator />

            <EmailInput @bind-Value="_passwordResetModel.Email" Label="Email" IsRequired="true" WrapperCssClass="mb-3" IsDisabled="true" />

            <div class="d-flex justify-content-between mb-3">
                <DigitInput @bind-Value="_passwordResetModel.DigitOne" CssClass="digit-control me-2" IsRequired="true" ShowValidationMessage="false" />
                <DigitInput @bind-Value="_passwordResetModel.DigitTwo" CssClass="digit-control me-2" IsRequired="true" ShowValidationMessage="false" />
                <DigitInput @bind-Value="_passwordResetModel.DigitThree" CssClass="digit-control me-2" IsRequired="true" ShowValidationMessage="false" />
                <DigitInput @bind-Value="_passwordResetModel.DigitFour" CssClass="digit-control" IsRequired="true" ShowValidationMessage="false" />
            </div>

            <PasswordInput Label="Senha" @bind-Value="_passwordResetModel.NewPassword" IsRequired="true" WrapperCssClass="mb-3" />

            <PasswordInput Label="Confirmar Senha" @bind-Value="_passwordResetModel.ConfirmNewPassword" IsRequired="true" WrapperCssClass="mb-3" />

            <Button Type="ButtonType.Submit" Color="ButtonColors.Primary" CssClass="w-100" IsLoading="_isLoadingPasswordReset">Enviar</Button>

        </EditForm>
    }

    <ProblemAlert @ref="_alert" CssClass="my-3" />

    <p class="text-center small text-muted mt-3 mb-0">
        <a href="@Routes.Web.Login" class="text-primary text-decoration-none fw-medium link-underline-opacity-0 link-underline-opacity-75-hover">
            Voltar para o Login
        </a>
    </p>
</CardContainer>