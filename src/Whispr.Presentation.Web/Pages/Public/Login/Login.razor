@page "/login"

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-light">
    <div class="card shadow-sm p-4" style="width: 100%; max-width: 380px;">

        <h4 class="mb-4 text-center fw-semibold">Entrar</h4>

        <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" class="form-control" placeholder="seu@email.com"
                   @bind="Email" />
        </div>

        <div class="mb-4">
            <label class="form-label">Senha</label>
            <input type="password" class="form-control" placeholder="••••••••"
                   @bind="Password" />
        </div>

        <button class="btn btn-primary w-100 mb-2" @onclick="HandleLogin">
            Entrar
        </button>

        <hr class="my-3 text-muted" />

        <button class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center gap-2"
                @onclick="HandleGoogleLogin">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 48 48">
                <path fill="#EA4335" d="M24 9.5c3.14 0 5.95 1.08 8.17 2.85l6.09-6.09C34.46 3.39 29.5 1.5 24 1.5 14.82 1.5 7.01 6.96 3.44 14.72l7.08 5.5C12.24 13.94 17.64 9.5 24 9.5z" />
                <path fill="#4285F4" d="M46.1 24.5c0-1.64-.15-3.22-.42-4.75H24v9h12.42c-.54 2.9-2.18 5.36-4.65 7.02l7.18 5.57C43.18 37.28 46.1 31.36 46.1 24.5z" />
                <path fill="#FBBC05" d="M10.52 28.22A14.6 14.6 0 0 1 9.5 24c0-1.47.25-2.9.69-4.22l-7.08-5.5A22.47 22.47 0 0 0 1.5 24c0 3.61.86 7.03 2.38 10.06l6.64-5.84z" />
                <path fill="#34A853" d="M24 46.5c5.5 0 10.12-1.82 13.49-4.95l-7.18-5.57C28.6 37.5 26.42 38.5 24 38.5c-6.36 0-11.76-4.44-13.48-10.28l-6.64 5.84C7.01 41.04 14.82 46.5 24 46.5z" />
            </svg>
            Continuar com Google
        </button>

    </div>
</div>