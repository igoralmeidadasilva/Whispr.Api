@page "/test"

<div class="row gap-3">
    <h3>Containers</h3>
    <div class="square bg-primary">Primary</div>
    <div class="square bg-primary-subtle">Primary Subtle</div>
    <div class="square bg-success">Success</div>
    <div class="square bg-success-subtle">Success Subtle</div>
    <div class="square bg-danger">Danger</div>
    <div class="square bg-danger-subtle">Danger Subtle</div>
    <div class="square bg-warning">Warning</div>
    <div class="square bg-warning-subtle">Warning Subtle</div>
    <div class="square bg-info">Info</div>
    <div class="square bg-info-subtle">Info Subtle</div>   
</div>

<div class="row">
    <h3>Text</h3>
    <p class="text-primary">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
