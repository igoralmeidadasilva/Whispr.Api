@page "/"
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable

<PageTitle>Home</PageTitle>

<div class="container p-3">
    <section class="justify-content-center bg-body-tertiary">
        <div class="whispr-bg-dark-blue text-white p-3">
            <h1 class="display-6">Whispr :: Chat</h1>
        </div>

        <div class="row p-3">
            <div class="col input-group input-group-sm">
                <span class="input-group-text">Nome</span>
                <InputText class="form-control" @bind-Value="UserName" disabled="@IsDisableChat" />
                <button class="btn btn-outline-secondary" type="button" @onclick="RegisterUserName" disabled="@IsDisableChat">Entrar</button>
            </div>
        </div>

        @if (IsDisableChat)
        {
            <div class="row p-3 overflow-auto" style="height: 60vh;">
                <div class="col" style="">
                    @foreach (var message in Messages)
                    {
                        if (message.UserName == UserName)
                        {
                            <p class="text-end">@message.UserMessage</p>
                        }
                        else
                        {
                            <p>@($"{message.UserName}: {message.UserMessage}")</p>
                        }
                    }
                </div>
            </div>
            <div class="row p-3">
                <form class="input-group input-group-sm" @onsubmit="HandleSubmitFormSendMessage">
                    <span class="input-group-text">T</span>
                    <InputText class="form-control" @bind-Value="NewMessage" />
                    <button class="btn btn-outline-success" type="submit"> > </button>
                </form>
            </div>
        }
    </section> 
</div>

@code {
    [Inject]
    public required NavigationManager NavigationManager { get; set; }

    private HubConnection? hubConnection;

    private string UserName { get; set; } = string.Empty;

    private record Message(string UserName, string UserMessage);

    private List<Message> Messages { get; set; } = [];

    private string NewMessage { get; set; } = string.Empty;

    private bool IsDisableChat = false;

    protected override async Task OnInitializedAsync()
    {
        hubConnection = new HubConnectionBuilder()
            .WithUrl("https://localhost:7023/chat-hub")
            .Build();

        hubConnection?.On<string, string>("ReceiveMessage", (user, message) =>
        {
            Messages.Add(new(user, message));
            InvokeAsync(StateHasChanged);
        });

        await hubConnection!.StartAsync();
    }

    private async Task HandleSubmitFormSendMessage()
    {
        if (!string.IsNullOrWhiteSpace(NewMessage))
        {
            if (hubConnection is not null)
            {
                await hubConnection.SendAsync("SendMessage", UserName, NewMessage);
            }
            NewMessage = string.Empty;
        }
    }

    private void RegisterUserName()
    {
        if (!string.IsNullOrEmpty(UserName))
        {
            IsDisableChat = true;
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
        {
            await hubConnection.StopAsync();
        }
    }
}