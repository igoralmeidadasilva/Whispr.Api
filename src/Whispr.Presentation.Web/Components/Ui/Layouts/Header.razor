@using Whispr.Presentation.Web.Components.Ui.Assets
@using Whispr.Presentation.Web.Components.Ui.Buttons
@using Whispr.Presentation.Web.Core.Enums

<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-header">
        <div class="container">
            <a class="navbar-brand logo-link text-white fw-bold fs-3" href="@Routes.Web.Home">
                <Logo />
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#@Id">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-end" id="@Id">
                <ul class="navbar-nav text-white">
                    <li class="nav-item"><NavLink ActiveClass="active-header-navlink" Match="NavLinkMatch.All" class="nav-link text-white" href="@Routes.Web.Contact">Contatos</NavLink></li>
                    <li class="nav-item"><NavLink ActiveClass="active-header-navlink" Match="NavLinkMatch.All" class="nav-link text-white" href="@Routes.Web.About">Sobre</NavLink></li>
                    <li class="nav-item"><NavLink ActiveClass="active-header-navlink" Match="NavLinkMatch.All" class="nav-link text-white" href="@Routes.Web.Register">Criar Conta</NavLink></li>
                    <li class="nav-item">
                        <Button Color="@ButtonColors.OutlineInfo" Rounded="@Rounded.Five" CssClass="px-4 border-2" OnClick="HandleLogoutOnClick">
                            Sair
                        </Button>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>