@using Whispr.Presentation.Web.Components.Ui.Assets

<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-header">
        <div class="container">
            <a class="navbar-brand logo-link text-white fw-bold fs-3" href="@Routes.Shared.Home">
                <Logo />
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#@Id">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-end" id="@Id">
                <ul class="navbar-nav text-white">
                    <li class="nav-item"><NavLink ActiveClass="active-header-navlink" Match="NavLinkMatch.All" class="nav-link text-white" href="@Routes.Shared.Contact">Contatos</NavLink></li>
                    <li class="nav-item"><NavLink ActiveClass="active-header-navlink" Match="NavLinkMatch.All" class="nav-link text-white" href="@Routes.Shared.About">Sobre</NavLink></li>
                    <li class="nav-item"><NavLink ActiveClass="active-header-navlink" Match="NavLinkMatch.All" class="nav-link text-white" href="@Routes.Shared.Register">Criar Conta</NavLink></li>
                    <li class="nav-item"><a class="btn btn-outline-info rounded-5 px-4 border-2" href="@Routes.Shared.Login">Entrar</a></li>
                </ul>
            </div>
        </div>
    </nav>
</header>