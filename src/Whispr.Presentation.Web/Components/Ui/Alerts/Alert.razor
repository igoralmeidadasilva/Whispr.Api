@using Whispr.Presentation.Web.Core.Extensions

@if(IsShow)
{
    <div @ref="Element" 
         id="@Id"
         class="@BuildCssClass()"
         role="alert"
         @attributes="@AdditionalAttributes">

        @if (IsDismissable)
        {
            <button type="button" class="btn-close" aria-label="Close" @onclick="Hide" />
        }

        @ChildContent

    </div>
}