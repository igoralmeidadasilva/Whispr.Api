@using Whispr.Presentation.Web.Core.Extensions

<div class="modal-header @Color.ToBgCss() @Color.ToTextColor() @CssClass">
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        <h1 class="modal-title fs-5">@Title</h1>
    }
    <button type="button" class="btn-close @Color.ToBtnCloseColor()" @onclick="HandleClickBtnClose" />
</div>