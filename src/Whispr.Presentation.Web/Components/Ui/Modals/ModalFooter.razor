@using Whispr.Presentation.Web.Components.Ui.Buttons
@using Whispr.Presentation.Web.Core.Enums
@using Whispr.Presentation.Web.Core.Extensions

<div class="modal-footer @CssClass">
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        @if (ShowCancelButton)
        {
            <Button Color="ButtonColors.Secondary" OnClick="HandleClickBtnClose">@CancelLabel</Button>
        }
        @if (ShowConfirmButton)
        {
            <Button Color="ConfirmColor" OnClick="HandleClickBtnConfirm">@ConfirmLabel</Button>
        }
    }
</div>