@using Whispr.Presentation.Web.Core.Extensions

<CascadingValue Value="this" Name="Parent" IsFixed="true">
    <div @ref="_element" 
         id="@Id" 
         class="modal fade @CssClass"
         tabindex="-1"
         data-bs-backdrop="@(IsStatic ? "static" : "true")"
         data-bs-keyboard="@(IsStatic ? "false" : "true")"
         @attributes="@AdditionalAttributes">
        <div class="modal-dialog modal-dialog-scrollable @Size.ToModalCss()">
            <div class="modal-content">
                @ChildContent
            </div>
        </div>
    </div>
</CascadingValue>