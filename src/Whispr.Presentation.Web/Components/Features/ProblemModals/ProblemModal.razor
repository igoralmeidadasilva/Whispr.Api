@using Whispr.Presentation.Web.Components.Ui.Alerts
@using Whispr.Presentation.Web.Components.Ui.Buttons
@using Whispr.Presentation.Web.Components.Ui.Icons
@using Whispr.Presentation.Web.Components.Ui.Modals
@using Whispr.Presentation.Web.Core.Enums

<Modal @ref="_modal" IsStatic="true">

    <ModalHeader Title="@Parameters.Title" Color="@Parameters.HeaderColor" />

    <ModalBody>
        <Alert Color="Colors.Danger" 
               CssClass="d-flex align-items-start gap-2 mb-3 border-0 border-start border-danger border-3 rounded-start-0"
               IsShow="true"
               IsDismissable="false">
            <Icon IconClass="IconClasses.ExclamationTriangleFill" CssClass="flex-shrink-0 mt-1" />
            <p class="mb-0 small">
                Ocorreu um erro ao processar sua solicitação. Por favor, tente novamente em instantes.
            </p>
        </Alert>

        <div class="d-flex flex-column gap-2 mb-3">
            @if (!string.IsNullOrEmpty(Parameters.Problem))
            {
                <div class="bg-body-secondary rounded p-3">
                    <p class="text-uppercase fw-semibold text-secondary mb-1" style="font-size: 0.68rem; letter-spacing: 0.07em;">Problema</p>
                    <p class="mb-0 small text-body">@Parameters.Problem</p>
                </div>
            }
            @if (!string.IsNullOrEmpty(Parameters.Description))
            {
                <div class="bg-body-secondary rounded p-3">
                    <p class="text-uppercase fw-semibold text-secondary mb-1" style="font-size: 0.68rem; letter-spacing: 0.07em;">Descrição</p>
                    <p class="mb-0 small text-body">@Parameters.Description</p>
                </div>
            }
        </div>

        @if (Parameters.Errors is { Count: > 0 })
        {
            <div class="border rounded mb-3">
                <div class="p-3">
                    <p class="text-uppercase fw-semibold text-secondary mb-3" style="font-size: 0.68rem; letter-spacing: 0.07em;">
                        Erros de validação
                    </p>
                    <div class="d-flex flex-column gap-2">
                        @foreach (var (field, messages) in Parameters.Errors)
                        {
                            <div>
                                <p class="fw-semibold text-secondary mb-1" style="font-size: 0.75rem;">@field</p>
                                <ul class="mb-0 ps-3 d-flex flex-column gap-1">
                                    @foreach (var message in messages)
                                    {
                                        <li class="small text-danger">@message</li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(Parameters.CorrelationId))
        {
            <div class="bg-body-secondary rounded d-flex align-items-center gap-3 py-2 px-3 mb-2">
                <span class="text-uppercase fw-semibold text-secondary flex-shrink-0" style="font-size: 0.68rem; letter-spacing: 0.07em;">
                    Protocolo
                </span>
                <code class="small fw-bold text-body mb-0 user-select-all">@Parameters.CorrelationId</code>
            </div>
            <p class="text-secondary mb-3" style="font-size: 0.75rem;">
                Se o problema continuar, entre em contato com o suporte informando o código acima.
            </p>
        }

        <div class="border-top pt-3 mt-1">
            <a class="d-inline-flex align-items-center gap-1 small text-primary text-decoration-none fw-medium link-underline-opacity-0 link-underline-opacity-75-hover"
               href="#">
                <Icon IconClass="IconClasses.ChatDotsFill" />
                Falar com o suporte
            </a>
        </div>
    </ModalBody>

    <ModalFooter ShowCancelButton="true" ShowConfirmButton="false" CancelLabel="Fechar" />

</Modal>