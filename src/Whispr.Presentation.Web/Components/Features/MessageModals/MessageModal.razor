@using Whispr.Presentation.Web.Components.Ui.Modals

<Modal @ref="_modal" IsStaticBackdrop="true">
    <ModalHeader Title="@Title" Color="@HeaderColor" />
    <ModalBody>
        <p>Ocorreu um erro ao processar sua solicitação. Por favor, tente novamente em instantes.</p>
        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="alert alert-danger" role="alert">
                <p class="p-0 m-0">@_message</p>
            </div>
        }
        <p>@_message</p>
        @if (!string.IsNullOrEmpty(_correlationId))
        {
            <p>Se o problema continuar, entre em contato com o suporte informando o código.</p>
            <p>Protocolo: <strong>@_correlationId</strong></p>
        }
        <a class="text-decoration-none text-dark" href="#">[Clicar aqui para falar com o suporte]</a>
    </ModalBody>
    <ModalFooter ShowActionButton="false" />
</Modal>