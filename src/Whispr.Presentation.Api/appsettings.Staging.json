{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Debug"
    }
  },
  "Serilog": {
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-ddTHH:mm:ss} {Level:u3}]: {SourceContext}{NewLine}{Message:lj}{NewLine}{Exception}",
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "restrictedToMinimumLevel": "Debug"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "[replace in secrets]"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "[replace in secrets]",
    "StorageConnection": "[replace in secrets]"
  },
  "EmailOptions": {
    "SmtpServer": "smtp.gmail.com",
    "Port": "587"
  },
  "GoogleOAuthOptions": {
    "ClientId": "[replace in secrets]",
    "ClientSecret": "[replace in secrets]"
  },
  "JwtAuthenticationOptions": {
    "Key": "[replace in secrets]",
    "Issuer": "Whispr.Api",
    "Audience": "Whispr.Api",
    "AccessTokenExpirationInMinutes": 15,
    "RefreshTokenExpirationInDays": 30
  },
  "StorageOptions": {
    "AccountKey": "[replace in secrets]",
    "AccountName": "[replace in secrets]",
    "ContainerName": "cnt-whispr-media-stg"
  }
}